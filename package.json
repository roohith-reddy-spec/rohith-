{
  "name": "kayden-ott-platform",
  "version": "1.0.0",
  "description": "KAYDEN - Premium Cinematic OTT Streaming Platform (MERN)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "kayden",
    "ott",
    "streaming",
    "mern",
    "cinema",
    "editorial"
  ],
  "author": "KAYDEN Media",
  "license": "UNLICENSED"
}
